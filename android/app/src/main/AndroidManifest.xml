<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- LAN and USB (adb reverse) connections to the PC. Nothing leaves your network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Reads the Wi-Fi subnet to find PCs by broadcast. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Opens the system installer for updates that the PC downloaded. You confirm each install. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 4.1 to 4.3 only: hands the update file to the installer through shared storage. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="18" />

    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Mobile Dock"
        android:supportsRtl="true"
        android:theme="@style/DockTheme">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|smallestScreenSize"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider
            android:name=".ApkProvider"
            android:authorities="dev.mobiledock.apk"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
